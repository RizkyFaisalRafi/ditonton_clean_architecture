# Podfile yang lebih robust
# Menentukan platform target global untuk proyek Anda.
platform :ios, '14.0'

# Menemukan path ke Flutter SDK dari file local.properties yang dibuat Flutter
def find_flutter_sdk_path
  File.read(File.join(File.dirname(__FILE__), '..', '.flutter-plugins-dependencies')).each_line do |line|
    if line.start_with?('flutter_sdk=')
      return line.split('=').last.strip
    end
  end
  return nil
end

flutter_sdk_path = find_flutter_sdk_path
if flutter_sdk_path.nil?
  raise 'Could not find Flutter SDK path. Please run `flutter pub get` first.'
end

load File.join(flutter_sdk_path, 'packages', 'flutter_tools', 'bin', 'podhelper.rb')

target 'Runner' do
  use_modular_headers!
  flutter_install_all_ios_pods(File.dirname(flutter_sdk_path))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end